#!/bin/rc
# /rc/bin/termrc.local — wanix host namespace mount.
#
# Sourced by /rc/bin/termrc at boot. The host namespace arrives over
# virtio-9p: the kernel's #9 device (devvirtio9p, in the 9pchalatha
# kernel) carries plain 9P2000 to wanix, so mounting it needs no helper
# process. A failure is reported on the console and in /tmp/host9p.err.

if(! test -d /n/host)
	mkdir -p /n/host
if(! mount -c '#9/0' /n/host >[2]/tmp/host9p.err)
	echo 'halatha: virtio-9p host mount failed; see /tmp/host9p.err' >/dev/cons
if not
	echo 'mounted #9/0' >/n/host/boot/host9p

# Halatha core service hook: start Yggdrasil after networking comes up.
# Background it so rio/terminal startup never waits on DHCP or peer dialing.
if(test -x /rc/bin/halatha.local)
	/rc/bin/halatha.local &
