+/* ACK and STATE carry read credit only after both SYNCs offered Ilflow. */
+static int
+ilcredit(Conv *s, Ilhdr *h)
+{
+	Ilcb *ic;
+	uchar *p;
+	uvlong read;
+
+	ic = (Ilcb*)s->ptcl;
+	if(!ic->flowpeer || nhgets(h->illen) < IL_HDRSIZE+Ilcreditlen)
+		return 0;
+	p = (uchar*)h + IL_HDRSIZE;
+	read = ((uvlong)nhgetl(p) << 32) | nhgetl(p+4);
+	if(read > ic->txbytes)
+		read = ic->txbytes;
+	if(read <= ic->peerread)
+		return 0;
+	ic->peerread = read;
+	return 1;
+}
