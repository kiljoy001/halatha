+
+static void
+ilsetip(Block *bp, int version, uchar *src, uchar *dst)
+{
+	Ip4hdr *h4;
+	Ip6hdr *h6;
+
+	if(version == V4){
+		h4 = (Ip4hdr*)bp->rp;
+		memset(h4, 0, IP4HDR);
+		h4->vihl = IP_VER4;
+		h4->proto = IP_ILPROTO;
+		v6tov4(h4->src, src);
+		v6tov4(h4->dst, dst);
+	} else {
+		h6 = (Ip6hdr*)bp->rp;
+		memset(h6, 0, IP6HDR);
+		h6->vcf[0] = IP_VER6;
+		h6->proto = IP_ILPROTO;
+		ipmove(h6->src, src);
+		ipmove(h6->dst, dst);
+	}
+}
