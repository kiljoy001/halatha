#!/bin/rc
# Rio startup: Aspera shelf dock + welcome tour + rc shell + snarf bridge.
# Rio -i runs this script windowless; the wctl window is the shell.
echo 'new -r 12 12 1012 96 shelf' > /dev/wctl
echo 'new -r 24 108 504 430 rc -c ''welcome; exec rc''' > /dev/wctl
echo 'new -r 520 108 1000 430 rc' > /dev/wctl
aspera-shelf-service &
snarfbridge &
