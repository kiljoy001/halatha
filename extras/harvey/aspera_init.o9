function raw_desktop() int64 {
    c {
        char *rargv[] = {"rio", "-t", "-s", "-i", "rc /lib/aspera/start.rc", nil};
        char *aargv[] = {"aspera-live", nil};
        char *value;
        int fd;
        if(bind("#c", "/dev", MAFTER) < 0 ||
           bind("#d", "/dev", MAFTER) < 0 ||
           bind("#d", "/fd", MREPL) < 0 ||
           bind("#p", "/proc", MREPL) < 0 ||
           bind("#s", "/srv", MREPL|MCREATE) < 0 ||
           bind("#ec", "/env", MREPL) < 0 ||
           bind("#e", "/env", MCREATE|MAFTER) < 0 ||
           bind("#@", "/mnt/o9", MREPL|MCREATE) < 0){
            sysfatal("halatha: desktop namespace: %r");
        }
        /* The standalone browser also supplies the OS root. Export only its
           services here; binding / would create /n/host/n/host/... cycles. */
        bind("#9", "/dev", MAFTER);
        if(access("/clip", AEXIST) == 0){
            if(bind("/clip", "/n/host/clip", MREPL|MCREATE) < 0)
                sysfatal("halatha: clipboard namespace: %r");
            if(bind("/lib/aspera/note.txt", "/n/host/note.txt", MREPL) < 0)
                print("halatha: browser note unavailable: %r\n");
            print("halatha: browser services at /n/host\n");
        }else{
            fd = open("#9/0", ORDWR);
            if(fd >= 0){
                if(mount(fd, -1, "/n/host", MREPL|MCREATE, "") < 0)
                    print("halatha: mount /n/host failed: %r\n");
                close(fd);
            }else
                print("halatha: /n/host unavailable: %r\n");
        }
        /* #~ (9ring) stays bound for high-speed display/input streaming. */
        bind("#~", "/dev", MAFTER);
        /* Draw (#i) and mouse (#m) for Rio's /dev/draw and /dev/mouse. */
        bind("#i", "/dev", MAFTER);
        bind("#m", "/dev", MAFTER);
        /* The staged root is not writable; give /tmp to the RAM
           device (#@) so shells and tools can create files. */
        if(bind("#@", "/tmp", MREPL|MCREATE) < 0)
            print("halatha: /tmp ram bind failed: %r\n");
        else
            print("halatha: /tmp on ram device\n");
        /* Enable PS/2 streaming + intellimouse wheel packets. */
        fd = open("/dev/mousectl", OWRITE);
        if(fd >= 0){
            write(fd, "ps2intellimouse", 15);
            close(fd);
        }
        chdir("/");
        /* Rio's title status reads these from the process environment. */
        value = getenv("user");
        if(value == nil || value[0] == 0)
            putenv("user", getuser());
        free(value);
        value = getenv("sysname");
        if(value == nil || value[0] == 0)
            putenv("sysname", "aspera");
        free(value);
        value = getenv("home");
        if(value == nil || value[0] == 0)
            putenv("home", "/");
        free(value);
        /* Mount before Rio starts; the child shares this namespace. */
        {
            char *targv[] = {"truetypefs", nil};
            int pid = rfork(RFPROC|RFFDG);
            if(pid == 0){
                exec("/bin/truetypefs", targv);
                _exits("truetypefs exec failed");
            }
            if(pid > 0){
                Waitmsg *w = wait();
                if(w != nil && w->msg[0] == 0)
                    print("halatha: truetypefs mounted at /n/ttf\n");
                else
                    print("halatha: truetypefs failed: %s\n", w != nil ? w->msg : "wait failed");
                free(w);
            }
        }
        /* Share the mount and environment with Rio, not just its startup rc. */
        {
            char *pargv[] = {"plumber", "-p", "/lib/aspera/plumbing", nil};
            int pid = rfork(RFPROC|RFFDG);
            if(pid == 0){
                exec("/bin/plumber", pargv);
                _exits("plumber exec failed");
            }
            if(pid > 0){
                Waitmsg *w = wait();
                if(w != nil && w->msg[0] == 0)
                    print("halatha: plumber ready\n");
                else
                    print("halatha: plumber failed: %s\n", w != nil ? w->msg : "wait failed");
                free(w);
            }
        }
        print("halatha: starting Rio\n");
        {
            int pid = rfork(RFPROC|RFFDG);
            if(pid == 0){
                exec("/bin/rio", rargv);
                _exits("rio exec failed");
            }
            if(pid > 0){
                Waitmsg *w = wait();
                print("halatha: Rio exited (%s); falling back to Aspera\n",
                    w != nil ? w->msg : "?");
                free(w);
            }
        }
        exec("/bin/aspera-live", aargv);
        sysfatal("halatha: exec desktop: %r");
    }
    return 0;
}

main {
    print("\nHalatha / Rio on v64\n");
    Task<int64> desktop = spawn raw_desktop();
    desktop.await();
}
