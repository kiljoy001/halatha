// clip: bidirectional bridge between Rio's /dev/snarf and the browser host
// clipboard at /n/host/clip/text.
//
// LIMITATION: transfers are capped at 8191 bytes (sizeof buf - 1). Content
// larger than that is truncated, and in `clip sync` a truncated read never
// compares equal to the source, so the loop rewrites it every 500ms. The
// rc twin (/rc/bin/clip, extras/9front/clip.rc) uses cat(1) and has no such
// cap; prefer it for large clipboards until this is switched to streaming.
function clipmainraw() int64 {
    int64 out;

    c {
        O9String *os;
        Dir *d, *dirs;
        char *cmd, *arg1, *env;
        char hostpath[256], snarfpath[256], buf[8192], lasthost[8192], lastsnarf[8192];
        vlong argc;
        int hfd, sfd, n, srvfd, pfd, i;

        out = 0;
        cmd = nil;
        arg1 = nil;
        env = nil;
        d = nil;
        dirs = nil;

        // 1. Locate host clipboard file (/n/host/clip/text or /n/wanix/clip/text)
        env = getenv("halroot");
        if(env != nil && env[0] != '\0')
            snprint(hostpath, sizeof hostpath, "%s/clip/text", env);
        else {
            d = dirstat("/n/wanix/clip/text");
            if(d != nil){
                snprint(hostpath, sizeof hostpath, "/n/wanix/clip/text");
                free(d);
                d = nil;
            } else
                snprint(hostpath, sizeof hostpath, "/n/host/clip/text");
        }
        if(env != nil)
            free(env);

        #define PROBE_RIO() do { \
            d = dirstat(snarfpath); \
            if(d == nil){ \
                d = dirstat("/mnt/wsys/snarf"); \
                if(d != nil){ \
                    snprint(snarfpath, sizeof snarfpath, "/mnt/wsys/snarf"); \
                    free(d); \
                    d = nil; \
                } else { \
                    srvfd = open("/srv", OREAD); \
                    if(srvfd >= 0){ \
                        int nd = dirreadall(srvfd, &dirs); \
                        close(srvfd); \
                        if(nd > 0){ \
                            for(i = 0; i < nd; i++){ \
                                if(strncmp(dirs[i].name, "rio.", 4) == 0){ \
                                    char srvfile[128]; \
                                    snprint(srvfile, sizeof srvfile, "/srv/%s", dirs[i].name); \
                                    pfd = open(srvfile, ORDWR); \
                                    if(pfd >= 0){ \
                                        int mfd = create("/mnt/wsys", OREAD, DMDIR|0777); \
                                        if(mfd >= 0) close(mfd); \
                                        mount(pfd, -1, "/mnt/wsys", MREPL, ""); \
                                        bind("/mnt/wsys", "/dev", MBEFORE); \
                                        close(pfd); \
                                        snprint(snarfpath, sizeof snarfpath, "/dev/snarf"); \
                                        break; \
                                    } \
                                } \
                            } \
                            free(dirs); \
                            dirs = nil; \
                        } \
                    } \
                } \
            } else { \
                free(d); \
                d = nil; \
            } \
        } while(0)

        // 2. Locate Rio snarf file (/dev/snarf or /mnt/wsys/snarf or mount /srv/rio.*)
        snprint(snarfpath, sizeof snarfpath, "/dev/snarf");
        PROBE_RIO();

        argc = o9_process_argc();
        if(argc > 1){
            os = o9_process_arg(1);
            cmd = o9_string_cstr(os);
            o9_string_release(os);
        }
        if(argc > 2){
            os = o9_process_arg(2);
            arg1 = o9_string_cstr(os);
            o9_string_release(os);
        }

        // Default with no args: show status of both clipboards
        if(argc < 2 || strcmp(cmd, "help") == 0 || strcmp(cmd, "-h") == 0){
            print("usage: clip in|get|paste       # copy host clipboard to /dev/snarf\n");
            print("       clip out|put|snarf      # copy /dev/snarf to host clipboard\n");
            print("       clip sync|daemon        # run background auto-synchronizer\n");
            print("       clip set <text>         # set clipboard in both host and guest\n");
            print("       clip print|-p           # print current /dev/snarf\n");
            print("endpoints:\n");
            print("  host:  %s\n", hostpath);
            print("  snarf: %s\n", snarfpath);
            goto clip_done;
        }

        // clip in / get / paste: host -> /dev/snarf
        if(strcmp(cmd, "in") == 0 || strcmp(cmd, "get") == 0 || strcmp(cmd, "paste") == 0){
            hfd = open(hostpath, OREAD);
            if(hfd < 0){
                print("clip: cannot open host clipboard %s\n", hostpath);
                goto clip_done;
            }
            n = read(hfd, buf, sizeof(buf)-1);
            close(hfd);
            if(n <= 0){
                print("clip: host clipboard is empty\n");
                goto clip_done;
            }
            buf[n] = '\0';

            sfd = open(snarfpath, OWRITE);
            if(sfd < 0)
                sfd = create(snarfpath, OWRITE, 0666);
            if(sfd < 0){
                print("clip: cannot open snarf buffer %s\n", snarfpath);
                goto clip_done;
            }
            write(sfd, buf, n);
            close(sfd); // Rio updates snarf on close
            print("clip: loaded %d bytes from host into /dev/snarf (ready for Button 2 -> Paste)\n", n);
            goto clip_done;
        }

        // clip out / put / snarf: /dev/snarf -> host
        if(strcmp(cmd, "out") == 0 || strcmp(cmd, "put") == 0 || strcmp(cmd, "snarf") == 0){
            sfd = open(snarfpath, OREAD);
            if(sfd < 0){
                print("clip: cannot open snarf buffer %s\n", snarfpath);
                goto clip_done;
            }
            n = read(sfd, buf, sizeof(buf)-1);
            close(sfd);
            if(n <= 0){
                print("clip: /dev/snarf is empty\n");
                goto clip_done;
            }
            buf[n] = '\0';

            hfd = create(hostpath, OWRITE, 0666);
            if(hfd < 0)
                hfd = open(hostpath, OWRITE);
            if(hfd < 0){
                print("clip: cannot open host clipboard %s\n", hostpath);
                goto clip_done;
            }
            write(hfd, buf, n);
            close(hfd);
            print("clip: sent %d bytes from /dev/snarf to host clipboard\n", n);
            goto clip_done;
        }

        // clip print / -p: print /dev/snarf to stdout
        if(strcmp(cmd, "print") == 0 || strcmp(cmd, "-p") == 0){
            sfd = open(snarfpath, OREAD);
            if(sfd >= 0){
                while((n = read(sfd, buf, sizeof buf)) > 0)
                    write(1, buf, n);
                close(sfd);
            }
            goto clip_done;
        }

        // clip set <text>: set both
        if(strcmp(cmd, "set") == 0 && arg1 != nil){
            n = strlen(arg1);
            sfd = open(snarfpath, OWRITE);
            if(sfd < 0)
                sfd = create(snarfpath, OWRITE, 0666);
            if(sfd >= 0){
                write(sfd, arg1, n);
                close(sfd);
            }
            hfd = create(hostpath, OWRITE, 0666);
            if(hfd < 0)
                hfd = open(hostpath, OWRITE);
            if(hfd >= 0){
                write(hfd, arg1, n);
                close(hfd);
            }
            print("clip: updated host and guest clipboards (%d bytes)\n", n);
            goto clip_done;
        }

        // clip sync / daemon: continuous sync loop
        if(strcmp(cmd, "sync") == 0 || strcmp(cmd, "daemon") == 0){
            print("clip: sync loop active (%s <-> %s)\n", hostpath, snarfpath);
            lasthost[0] = '\0';
            lastsnarf[0] = '\0';

            // Prime with current host
            hfd = open(hostpath, OREAD);
            if(hfd >= 0){
                n = read(hfd, lasthost, sizeof(lasthost)-1);
                close(hfd);
                if(n > 0) lasthost[n] = '\0';
            }
            // Prime with current snarf
            sfd = open(snarfpath, OREAD);
            if(sfd >= 0){
                n = read(sfd, lastsnarf, sizeof(lastsnarf)-1);
                close(sfd);
                if(n > 0) lastsnarf[n] = '\0';
            }

            for(;;){
                sleep(500);
                PROBE_RIO();

                // Check host
                hfd = open(hostpath, OREAD);
                if(hfd >= 0){
                    n = read(hfd, buf, sizeof(buf)-1);
                    close(hfd);
                    if(n >= 0){
                        buf[n] = '\0';
                        if(strcmp(buf, lasthost) != 0){
                            strcpy(lasthost, buf);
                            strcpy(lastsnarf, buf);
                            sfd = open(snarfpath, OWRITE);
                            if(sfd < 0)
                                sfd = create(snarfpath, OWRITE, 0666);
                            if(sfd >= 0){
                                write(sfd, buf, n);
                                close(sfd); // updates Rio snarf buffer!
                            }
                            continue;
                        }
                    }
                }

                // Check snarf
                sfd = open(snarfpath, OREAD);
                if(sfd >= 0){
                    n = read(sfd, buf, sizeof(buf)-1);
                    close(sfd);
                    if(n >= 0){
                        buf[n] = '\0';
                        if(strcmp(buf, lastsnarf) != 0){
                            strcpy(lastsnarf, buf);
                            strcpy(lasthost, buf);
                            hfd = create(hostpath, OWRITE, 0666);
                            if(hfd < 0)
                                hfd = open(hostpath, OWRITE);
                            if(hfd >= 0){
                                write(hfd, buf, n);
                                close(hfd);
                            }
                            continue;
                        }
                    }
                }
            }
        }

        print("clip: unknown command %s\n", cmd);

    clip_done:
        ;
    }

    return out;
}

main {
    Task<int64> t = spawn clipmainraw();
    int64 ignored = t.await();
}
