+	}
+	if not if(test -x /bin/mpc){
+		echo '#include "os.h"' > $target
+		echo '#include <mp.h>' >> $target
+		mpc $prereq >> $target
+	}
+	if not {
+		# mpc absent: keep the committed $target unchanged
