{
    "name": "wanix",
    "version": "0.4.0-beta",
    "type": "module",
    "main": "dist/wanix.js",
    "module": "index.ts",
    "files": [
        "dist/**/*.wasm",
        "dist/**/*.js"
    ],
    "scripts": {
        "build": "make js",
        "prepublishOnly": "npm run build",
